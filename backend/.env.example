# Copy to .env. Every OVAEL_* setting in ovael/config.py can be set here.

# --- secrets (set all of these in production) ---
POSTGRES_PASSWORD=change-me
OVAEL_ADMIN_TOKEN=change-me-admin
OVAEL_SENSOR_TOKEN=change-me-sensor
OVAEL_DEFENSE_TOKEN=change-me-defense
OVAEL_SCANNER_TOKEN=

# --- defense: off | simulate | agent ---
# "agent" needs ovael.defense.agent running in the protected host's network namespace.
OVAEL_DEFENSE_MODE=simulate
# OVAEL_DEFENSE_AGENT_URL=http://protected-host:9100

# --- tuning ---
OVAEL_ANOMALY_THRESHOLD=0.99
OVAEL_SCAN_RATE_LIMIT=10
OVAEL_SCAN_CACHE_TTL_S=21600
OVAEL_RETRAIN_MIN_NEW_SAMPLES=25
OVAEL_ENABLE_SIMULATOR=true
OVAEL_CORS_ORIGINS=["http://localhost","http://localhost:5173"]

# --- optional read replica for dashboard queries ---
# OVAEL_DATABASE_READ_URL=postgresql+asyncpg://ovael:...@postgres-replica:5432/ovael
